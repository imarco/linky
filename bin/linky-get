#!/usr/bin/env python3
"""Archive explicitly requested public resources without ambient credentials."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
from linky.acquire import Limits, acquire_batch


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('urls', nargs='+', help='Public direct resource URLs or article pages')
    parser.add_argument('--output', default='.linky/downloads', help='Archive directory (no symlink components)')
    parser.add_argument('--allow-media', action='store_true', help='Only use when user explicitly requested public media or existing subtitles')
    parser.add_argument('--article-images', action='store_true', help='Also archive bounded images directly referenced by article pages')
    parser.add_argument('--max-bytes', type=int, default=50*1024*1024, help='Per-file byte cap (max 1 GiB)')
    parser.add_argument('--max-total-bytes', type=int, default=200*1024*1024, help='Batch byte cap (max 5 GiB)')
    parser.add_argument('--max-files', type=int, default=20, help='Batch artifact cap (max 100)')
    args = parser.parse_args(argv)
    try:
        limits = Limits(max_bytes=args.max_bytes, max_total_bytes=args.max_total_bytes, max_files=args.max_files)
        batch = acquire_batch(args.urls, args.output, allow_media=args.allow_media, article_images=args.article_images, limits=limits)
    except (ValueError, OSError) as exc:
        parser.exit(2, f'Archive could not be created ({type(exc).__name__}); check output path and limits.\n')
    print(json.dumps(batch.to_dict(), ensure_ascii=False, indent=2))
    return 0 if not batch.limited and all(r.status == 'complete' for r in batch.results) else 1

if __name__ == '__main__':
    raise SystemExit(main())
